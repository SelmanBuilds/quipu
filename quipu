#!/bin/sh
# quipu — vault CLI for tool-use memory: capture, index, search, doctor.
# Single-file POSIX sh (PLAN FAZ 1). No bashisms: no [[ ]], no local,
# no ${var,,}; helpers are _q_-prefixed globals.
#
# Backslash policy (PLAN 4.11): literal backslashes appear only as DATA in
# single-quoted printf formats / expected values, never as logic escapes.
# Control bytes are produced from code points (awk sprintf("%c",N)).

set -eu

# ---- helpers ----------------------------------------------------------------

_q_home() {
  # Install directory of the quipu script (or QUIPU_HOME override).
  if [ -n "${QUIPU_HOME:-}" ]; then
    printf '%s\n' "$QUIPU_HOME"
    return 0
  fi
  CDPATH='' cd -- "$(dirname -- "$0")" && pwd
}

_q_vault() {
  # Vault root: nearest ancestor of $PWD holding .quipu/config (git-style
  # walk-up), or the QUIPU_VAULT override. Empty when none found.
  if [ -n "${QUIPU_VAULT:-}" ]; then
    printf '%s\n' "$QUIPU_VAULT"
    return 0
  fi
  _q_dir=$PWD
  while :; do
    if [ -f "$_q_dir/.quipu/config" ]; then
      printf '%s\n' "$_q_dir"
      return 0
    fi
    _q_parent=$(dirname "$_q_dir")
    if [ "$_q_parent" = "$_q_dir" ]; then
      break
    fi
    _q_dir=$_q_parent
  done
  return 0
}

_q_lang() {
  # Language chain: QUIPU_LANG -> vault .quipu/config lang= ->
  # LC_ALL/LANG prefix (before first dot/underscore) -> en.
  _q_l=${QUIPU_LANG:-}
  if [ -z "$_q_l" ]; then
    _q_v=$(_q_vault)
    if [ -n "$_q_v" ] && [ -f "$_q_v/.quipu/config" ]; then
      _q_l=$(awk -F= -v k=lang '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
    fi
  fi
  if [ -z "$_q_l" ]; then
    _q_l=${LC_ALL:-${LANG:-}}
    _q_l=${_q_l%%.*}
    _q_l=${_q_l%%_*}
  fi
  if [ -z "$_q_l" ]; then
    _q_l=en
  fi
  printf '%s\n' "$_q_l"
}

_q_msg() {
  # Look up a key in the active language file; fall back to en, then the key.
  _q_l=$(_q_lang)
  _q_f="$_q_HOME/i18n/$_q_l.txt"
  if [ ! -f "$_q_f" ]; then
    _q_f="$_q_HOME/i18n/en.txt"
  fi
  _q_v=
  if [ -f "$_q_f" ]; then
    _q_v=$(awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_f" 2>/dev/null || true)
  fi
  if [ -n "$_q_v" ]; then
    printf '%s\n' "$_q_v"
  else
    printf '%s\n' "$1"
  fi
}

_q_die() {
  # _q_die key [code [arg…]] — extra args are printf'd into the message format
  # (FAZ 7 J-2). Legacy `key [code]` calls behave exactly as before.
  _q_dk=$1
  shift
  _q_dc=${1:-1}
  [ "$#" -eq 0 ] || shift
  if [ "$#" -gt 0 ]; then
    _q_dfmt=$(_q_msg "$_q_dk")
    # shellcheck disable=SC2059
    printf "$_q_dfmt\n" "$@" >&2
  else
    _q_msg "$_q_dk" >&2
  fi
  if [ "${QUIPU_HOOK:-0}" = 1 ]; then
    exit 0
  fi
  exit "$_q_dc"
}

_q_warn() {
  _q_msg "$1" >&2
}

_q_line() {
  # Print one doctor row: status<TAB>name<TAB>detail; bump the counter.
  case "$1" in
    ok) OK=$((OK + 1)); _q_st=$(_q_msg doc_ok) ;;
    warn) WARN=$((WARN + 1)); _q_st=$(_q_msg doc_warn) ;;
    fail) FAIL=$((FAIL + 1)); _q_st=$(_q_msg doc_fail) ;;
    *) _q_st=$1 ;;
  esac
  printf '%s\t%s\t%s\n' "$_q_st" "$2" "$3"
}

usage() {
  _q_msg usage_head
  _q_msg usage_doctor
  _q_msg usage_capture
  _q_msg usage_index
  _q_msg usage_search
  _q_msg usage_init
  _q_msg usage_context
  _q_msg usage_remember
}

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

_q_md_filter() {
  # stdin -> stdout: keep only .md vault-relative paths, dropping the agent
  # bridge files and the pruned prefixes. Single source for _q_mdlist and
  # `capture --git` (DZ-3): substr/index only, no regex (PLAN 4.8/4.17).
  awk '
    length($0) < 3 { next }
    substr($0, length($0) - 2) != ".md" { next }
    $0 == "AGENTS.md" { next }
    $0 == "CLAUDE.md" { next }
    index($0, ".quipu/") == 1 { next }
    index($0, ".git/") == 1 { next }
    index($0, "node_modules/") == 1 { next }
    { print }
  '
}

_q_mdlist() {
  # Vault-relative .md paths, excluding agent-bridge files. Caller must cd to
  # the vault first. $1 (optional): only files newer than this path.
  if [ -n "${1:-}" ]; then
    find . \( -name .git -o -name .quipu -o -name node_modules \) -prune -o \
      -type f -name '*.md' -newer "$1" -print
  else
    find . \( -name .git -o -name .quipu -o -name node_modules \) -prune -o \
      -type f -name '*.md' -print
  fi | sed 's|^\./||' | _q_md_filter
}

# ---- init -------------------------------------------------------------------

_q_HOME=$(_q_home)

# ---- doctor -----------------------------------------------------------------

_q_doctor() {
  OK=0
  WARN=0
  FAIL=0

  _q_msg doc_head

  _q_msg doc_sec_tools
  for _q_t in sh sed awk grep tr git find date head; do
    if _q_p=$(command -v "$_q_t" 2>/dev/null); then
      _q_line ok "$_q_t" "$_q_p"
    else
      _q_line fail "$_q_t" "-"
    fi
  done

  _q_msg doc_sec_dialects
  if stat -c %Y "$0" >/dev/null 2>&1; then
    _q_line ok stat "$(_q_msg doc_stat_gnu)"
  elif stat -f %m "$0" >/dev/null 2>&1; then
    _q_line ok stat "$(_q_msg doc_stat_bsd)"
  else
    _q_line fail stat "$(_q_msg doc_stat_none)"
  fi
  _q_awk=$(awk 'BEGIN{printf "%c",92}')
  # The shell must itself produce one backslash byte to test awk against.
  # shellcheck disable=SC1003
  _q_bs=$(printf '\\')
  if [ "$_q_awk" = "$_q_bs" ]; then
    _q_line ok awk "$(_q_msg doc_awk_bs)"
  else
    _q_line fail awk "$(_q_msg doc_awk_bs)"
  fi

  _q_msg doc_sec_files
  for _q_f in fold/tr.sed fold/latin.sed fold/default.sed i18n/en.txt i18n/tr.txt layout/emoji.txt layout/plain.txt persona/en.md persona/tr.md; do
    if [ -f "$_q_HOME/$_q_f" ]; then
      _q_line ok "$_q_f" "-"
    else
      _q_line fail "$_q_f" "-"
    fi
  done
  _q_tab=$(printf '\t')
  _q_s1=$(awk -F"$_q_tab" 'NF >= 2 && $0 !~ /^#/ {print $1}' "$_q_HOME/layout/emoji.txt" 2>/dev/null || true)
  _q_s2=$(awk -F"$_q_tab" 'NF >= 2 && $0 !~ /^#/ {print $1}' "$_q_HOME/layout/plain.txt" 2>/dev/null || true)
  if [ -n "$_q_s1" ] && [ "$_q_s1" = "$_q_s2" ]; then
    _q_line ok 'layout/*.txt' '-'
  else
    _q_line fail 'layout/*.txt' "$(_q_msg doc_layout_mismatch)"
  fi

  _q_msg doc_sec_vault
  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_line warn vault "$(_q_msg doc_vault_missing)"
  else
    _q_line ok vault "$(_q_msg doc_vault_ok)"
    # FAZ 2 (spec 4.6 B-21): layout line from config.
    _q_lay=
    if [ -f "$_q_v/.quipu/config" ]; then
      _q_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
    fi
    if [ -z "$_q_lay" ]; then
      _q_line warn "$(_q_msg doc_layout)" "$(_q_msg doc_layout_missing)"
    else
      _q_line ok "$(_q_msg doc_layout)" "$_q_lay"
    fi
    # FAZ 2 (spec 4.6 B-22): companion check, only for a known layout.
    if [ "$_q_lay" = emoji ] || [ "$_q_lay" = plain ]; then
      _q_comp=$(awk -F"$_q_tab" '$1=="companion"{print $2;exit}' "$_q_HOME/layout/$_q_lay.txt" 2>/dev/null || true)
      if [ -n "$_q_comp" ] && [ ! -f "$_q_v/$_q_comp/companion.md" ]; then
        _q_line warn companion "$(_q_msg doc_companion_missing)"
      fi
    fi
    if [ ! -f "$_q_v/.quipu/index.tsv" ]; then
      _q_line warn index "$(_q_msg doc_index_stale)"
    else
      _q_new=$( (cd "$_q_v" && _q_mdlist .quipu/index.tsv) 2>/dev/null || true)
      if [ -n "$_q_new" ]; then
        _q_line warn index "$(_q_msg doc_index_stale)"
      else
        _q_line ok index "-"
      fi
    fi
    _q_log="$_q_v/.quipu/activity.log"
    if [ -f "$_q_log" ]; then
      _q_size=$(wc -c < "$_q_log")
    else
      _q_size=0
    fi
    _q_line ok "$(_q_msg doc_log_size)" "$_q_size"
  fi

  _q_msg doc_sec_agents
  if [ -e "$HOME/.claude/settings.json" ] && grep -q quipu "$HOME/.claude/settings.json"; then
    _q_line ok 'claude hooks' "$(_q_msg doc_hooks_installed)"
  else
    _q_line warn 'claude hooks' "$(_q_msg doc_hooks_missing)"
  fi
  if [ -e "$HOME/.codex/config.toml" ]; then
    _q_line ok codex "$HOME/.codex/config.toml"
  fi
  if [ -e "./opencode.json" ]; then
    _q_line ok opencode "./opencode.json"
  fi
  if [ -e "./cursor-hooks/hooks.json" ]; then
    _q_line ok cursor "./cursor-hooks/hooks.json"
  fi
  if [ -e "./.windsurf" ]; then
    _q_line ok windsurf "./.windsurf"
  fi

  _q_msg doc_sec_warn
  _q_lay=${_q_lay:-}
  _q_v=$(_q_vault)
  # PLAN 4.9: the emoji-folder risk applies when the active layout is emoji, and
  # also when no layout is resolved yet - the next `init` defaults to emoji.
  if [ "$_q_lay" != plain ]; then
    case "$_q_HOME" in
      *OneDrive*) _q_line warn path "$(_q_msg doc_onedrive)" ;;
    esac
  fi
  if [ "$_q_lay" = emoji ]; then
    case "$_q_v" in
      *OneDrive*) _q_line warn vault "$(_q_msg doc_onedrive_vault)" ;;
    esac
  fi
  if awk 'index($0, sprintf("%c",13)) != 0 {c=1} END{exit !c}' "$0" 2>/dev/null; then
    _q_line warn eol "$(_q_msg doc_crlf)"
  fi
  _q_lc=${LC_ALL:-${LANG:-}}
  if [ -n "$_q_lc" ]; then
    case "$_q_lc" in
      *UTF-8*|*utf-8*|C|POSIX) : ;;
      *) _q_line warn locale "$(_q_msg doc_locale)" ;;
    esac
  fi

  _q_fmt=$(_q_msg doc_summary)
  # doc_summary carries %d placeholders resolved by printf below; the format
  # string comes from i18n, so it must be used as the printf format directly.
  # shellcheck disable=SC2059
  printf "$_q_fmt" "$OK" "$WARN" "$FAIL"
  printf '\n'
  if [ "$FAIL" -gt 0 ]; then
    exit 1
  fi
  exit 0
}

# ---- capture ----------------------------------------------------------------

# Normalize one path held in $_q_p (Windows drive-letter -> POSIX via cygpath
# when the result lives inside the vault; vault-relative strip; TAB/CR/LF
# removal). Caller sets $_q_p and $_q_v first.
_q_norm_path() {
  case "$_q_p" in
    [A-Za-z]:*)
      if command -v cygpath >/dev/null 2>&1; then
        _q_orig=$_q_p
        _q_p=$(cygpath -u "$_q_p" 2>/dev/null || printf '%s\n' "$_q_p")
        case "$_q_p" in
          "$_q_v"/*) : ;;
          *) _q_p=$_q_orig ;;
        esac
      fi
      ;;
  esac
  # Make it vault-relative when inside the vault, then strip TAB/CR/LF.
  _q_p=${_q_p#"$_q_v"/}
  _q_tab=$(printf '\t')
  _q_p=$(printf '%s\n' "$_q_p" | tr -d "$_q_tab$(printf '\r\n')")
}

# Rotate activity.log once: mv to .1 and open a fresh file when over limit.
# Caller sets $_q_v first; this sets $_q_log.
_q_rotate_log() {
  _q_log="$_q_v/.quipu/activity.log"
  if [ -f "$_q_log" ]; then
    _q_size=$(wc -c < "$_q_log")
    if [ "$_q_size" -gt "${QUIPU_LOG_MAX:-262144}" ]; then
      mv -f "$_q_log" "$_q_log.1"
      : > "$_q_log"
    fi
  fi
}

# Append one row (already normalized) to activity.log. Caller sets $_q_ev,
# $_q_tool, $_q_p and has run _q_rotate_log (which sets $_q_log).
_q_append_line() {
  printf '%s | %s | %s | %s\n' "$(date +%Y-%m-%dT%H:%M)" "$_q_ev" "$_q_tool" "$_q_p" >> "$_q_log"
}

_q_cmd_capture() {
  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_ev=
  _q_tool=
  _q_p=
  _q_flag=0
  _q_git=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --git) _q_git=1; shift ;;
      --event) _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_ev=$2; shift 2 ;;
      --tool)  _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_tool=$2; shift 2 ;;
      --path)  _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_p=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  if [ "$_q_git" -eq 1 ] && [ "$_q_flag" -eq 1 ]; then
    _q_die err_conflict 2
  fi

  # Flag-mode mandatory args: checked before any subshell that reuses _q_p.
  if [ "$_q_flag" -eq 1 ]; then
    if [ -z "$_q_ev" ] || [ -z "$_q_tool" ] || [ -z "$_q_p" ]; then
      _q_die err_missing_arg 2
    fi
  fi

  if [ "$_q_git" -eq 1 ]; then
    # H-2: silent no-op when git is missing or the vault is not a repo.
    if ! command -v git >/dev/null 2>&1 || ! (cd "$_q_v" && git rev-parse --git-dir >/dev/null 2>&1); then
      exit 0
    fi
    # H-3 + DZ-2: changed tracked files only when HEAD exists; an unborn HEAD
    # would make `git diff --name-only HEAD` exit 128 and trip `set -eu`.
    if (cd "$_q_v" && git rev-parse --verify --quiet HEAD >/dev/null 2>&1); then
      _q_ch=$( (cd "$_q_v" && git diff --name-only HEAD 2>/dev/null) )
    else
      _q_ch=""
    fi
    _q_un=$( (cd "$_q_v" && git ls-files --others --exclude-standard 2>/dev/null) )
    # H-4 + DZ-3: single .md filter (stdin -> stdout).
    _q_md=$( { printf '%s\n' "$_q_ch"; printf '%s\n' "$_q_un"; } | _q_md_filter )
    # H-8: nothing changed -> silent success (H-7: stdout stays empty).
    [ -n "$_q_md" ] || exit 0
    # H-6: rotate once before the loop; H-5: shared per-line functions.
    _q_ev=gitdiff
    _q_tool=git
    _q_rotate_log
    printf '%s\n' "$_q_md" | while IFS= read -r _q_ln; do
      [ -n "$_q_ln" ] || continue
      _q_p=$_q_ln
      _q_norm_path
      _q_append_line
    done
    exit 0
  fi

  if [ "$_q_flag" -eq 0 ]; then
    _q_tab=$(printf '\t')
    _q_out=$(head -c "${QUIPU_MAX_STDIN:-65536}" | awk -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/capture.awk")
    if [ -z "$_q_out" ]; then
      exit 0
    fi
  fi

  # Rotate once, before any append: a multi-row capture must never rotate
  # mid-loop (earlier rows would be moved into activity.log.1 and lost).
  _q_rotate_log

  if [ "$_q_flag" -eq 1 ]; then
    _q_norm_path
    _q_append_line
  else
    # capture.awk may emit zero or many rows. Parameter expansion only: a
    # heredoc would re-expand $ and backticks inside the path (corruption).
    printf '%s\n' "$_q_out" | while IFS= read -r _q_ln; do
      _q_ev=${_q_ln%%"$_q_tab"*}
      _q_rest=${_q_ln#*"$_q_tab"}
      _q_tool=${_q_rest%%"$_q_tab"*}
      _q_p=${_q_rest#*"$_q_tab"}
      if [ -z "$_q_ev" ] || [ -z "$_q_tool" ] || [ -z "$_q_p" ]; then
        continue
      fi
      _q_norm_path
      _q_append_line
    done
  fi
}

# ---- init -------------------------------------------------------------------

_q_cmd_init() {
  _q_v=${QUIPU_VAULT:-$PWD}
  _q_lang=
  _q_git=0
  _q_plain=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --plain) _q_plain=1; shift ;;
      --git) _q_git=1; shift ;;
      --lang) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_lang=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  _q_changed=0

  mkdir -p "$_q_v/.quipu"

  if [ ! -f "$_q_v/.quipu/config" ]; then
    : > "$_q_v/.quipu/config"
    _q_changed=1
  fi

  # Layout resolution (FAZ 2 spec 4.1): an existing config value wins; a
  # conflicting --plain flag is a hard error before anything is written.
  _q_cfg=
  if [ -f "$_q_v/.quipu/config" ]; then
    _q_cfg=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
  fi
  if [ -n "$_q_cfg" ]; then
    case "$_q_cfg" in
      emoji|plain) : ;;
      *) _q_die err_layout_unknown 2 ;;
    esac
    if [ "$_q_plain" -eq 1 ] && [ "$_q_cfg" = emoji ]; then
      _q_die err_layout_conflict 2
    fi
    _q_layout=$_q_cfg
  else
    if [ "$_q_plain" -eq 1 ]; then
      _q_layout=plain
    else
      _q_layout=emoji
    fi
    printf 'layout=%s\n' "$_q_layout" >> "$_q_v/.quipu/config"
    _q_changed=1
  fi

  if [ -n "$_q_lang" ]; then
    if grep -q '^lang=' "$_q_v/.quipu/config"; then
      sed "s/^lang=.*/lang=$_q_lang/" "$_q_v/.quipu/config" > "$_q_v/.quipu/config.tmp" && mv "$_q_v/.quipu/config.tmp" "$_q_v/.quipu/config"
    else
      printf 'lang=%s\n' "$_q_lang" >> "$_q_v/.quipu/config"
    fi
    _q_changed=1
  fi

  if [ ! -f "$_q_v/.quipu/index.tsv" ]; then
    : > "$_q_v/.quipu/index.tsv"
    _q_changed=1
  fi

  if [ ! -f "$_q_v/.quipu/activity.log" ]; then
    : > "$_q_v/.quipu/activity.log"
    _q_changed=1
  fi

  if [ "$_q_git" -eq 1 ]; then
    git init -q "$_q_v"
    _q_changed=1
  fi

  # Folder tree: names come from layout/<layout>.txt (spec 2.1, B-3/B-10).
  _q_tab=$(printf '\t')
  while IFS= read -r _q_ln; do
    [ -n "$_q_ln" ] || continue
    case "$_q_ln" in
      '#'*) continue ;;
    esac
    _q_name=${_q_ln#*"$_q_tab"}
    [ "$_q_name" = "$_q_ln" ] && continue
    mkdir -p "$_q_v/$_q_name"
    if [ ! -f "$_q_v/$_q_name/.gitkeep" ]; then
      : > "$_q_v/$_q_name/.gitkeep"
    fi
  done < "$_q_HOME/layout/$_q_layout.txt"

  # Companion and command-center folder names (seeds + bridge body).
  _q_cname=
  _q_dname=
  while IFS= read -r _q_ln; do
    [ -n "$_q_ln" ] || continue
    case "$_q_ln" in
      '#'*) continue ;;
    esac
    _q_slug=${_q_ln%%"$_q_tab"*}
    [ "$_q_slug" = companion ] && _q_cname=${_q_ln#*"$_q_tab"}
    [ "$_q_slug" = command ] && _q_dname=${_q_ln#*"$_q_tab"}
  done < "$_q_HOME/layout/$_q_layout.txt"

  # Seeds: only-if-missing, never touched again (spec 4.2, B-9).
  _q_comp=0
  if [ -n "$_q_cname" ]; then
    _q_pers=$(_q_lang)
    if [ ! -f "$_q_HOME/persona/$_q_pers.md" ]; then
      _q_pers=en
    fi
    if [ ! -f "$_q_v/$_q_cname/companion.md" ]; then
      cp "$_q_HOME/persona/$_q_pers.md" "$_q_v/$_q_cname/companion.md"
      _q_changed=1
      _q_comp=1
    fi
  fi

  if [ ! -f "$_q_v/Threads.md" ]; then
    printf '%s\n%s\n' "$(_q_msg threads_seed_title)" "$(_q_msg threads_seed_note)" > "$_q_v/Threads.md"
    _q_changed=1
  fi

  if [ -n "$_q_dname" ] && [ ! -f "$_q_v/$_q_dname/Dashboard.md" ]; then
    printf '%s\n%s\n' "$(_q_msg dashboard_seed_title)" "$(_q_msg dashboard_seed_note)" > "$_q_v/$_q_dname/Dashboard.md"
    _q_changed=1
  fi

  # AGENTS.md bridge block: body from i18n + layout file, via stdin (B-13).
  : >> "$_q_v/AGENTS.md"
  _q_had_block=0
  if grep -q 'quipu:start' "$_q_v/AGENTS.md"; then
    _q_had_block=1
  fi
  {
    printf '%s\n' '## quipu'
    printf '%s\n' "$(_q_msg bridge_run)"
    printf '%s\n' "$(_q_msg bridge_layout)"
    while IFS= read -r _q_ln; do
      [ -n "$_q_ln" ] || continue
      case "$_q_ln" in
        '#'*) continue ;;
      esac
      _q_slug=${_q_ln%%"$_q_tab"*}
      _q_name=${_q_ln#*"$_q_tab"}
      printf '  - %s — %s\n' "$_q_name" "$(_q_msg "layout_$_q_slug")"
    done < "$_q_HOME/layout/$_q_layout.txt"
    # bridge_companion carries %s; resolved by printf below (SC2059 pattern).
    # shellcheck disable=SC2059
    printf "$(_q_msg bridge_companion)\n" "$_q_cname"
    printf '%s\n' "$(_q_msg bridge_append)"
  } | awk -f "$_q_HOME/lib/block.awk" "$_q_v/AGENTS.md" > "$_q_v/.quipu/agents.tmp" && mv "$_q_v/.quipu/agents.tmp" "$_q_v/AGENTS.md"

  # CLAUDE.md: thin pointer, single marker block (spec 4.4, B-14/B-15).
  : >> "$_q_v/CLAUDE.md"
  printf '%s\n' "$(_q_msg bridge_claude)" | awk -f "$_q_HOME/lib/block.awk" "$_q_v/CLAUDE.md" > "$_q_v/.quipu/claude.tmp" && mv "$_q_v/.quipu/claude.tmp" "$_q_v/CLAUDE.md"

  if [ "$_q_changed" -eq 0 ] && [ "$_q_had_block" -eq 1 ]; then
    _q_msg init_idem
  else
    # shellcheck disable=SC2059
    printf "$(_q_msg init_ok)\n" "$_q_v"
    if [ "$_q_git" -eq 1 ]; then
      _q_msg init_git
    fi
    if [ -n "$_q_lang" ]; then
      # shellcheck disable=SC2059
      printf "$(_q_msg init_lang)\n" "$_q_lang"
    fi
    # shellcheck disable=SC2059
    printf "$(_q_msg init_layout)\n" "$_q_layout"
    if [ "$_q_had_block" -eq 0 ]; then
      _q_msg init_agents
    fi
    if [ "$_q_comp" -eq 1 ]; then
      _q_msg init_companion
    fi
    _q_msg init_next
  fi
}

# ---- context ----------------------------------------------------------------

_q_ctx_text() {
  # Global setter (DZ-7): builds $_q_text (and $_q_log) for the session
  # context — activity + index + Threads.md (QUIPU_CTX_MAX bounded), no
  # stdout. The nudge block stays OUTSIDE (--json UserPromptSubmit only).
  # Caller sets $_q_v and $_q_limit first.
  _q_log="$_q_v/.quipu/activity.log"

  # Fixed part A: activity section (tail lines + per-path digest table).
  _q_act=
  _q_add_act() {
    _q_act="${_q_act}${1}
"
  }
  _q_add_act "$(_q_msg ctx_activity)"
  if [ -s "$_q_log" ]; then
    _q_add_act "$(awk -v n="$_q_limit" '{ line[NR] = $0 } END { s = NR - n + 1; if (s < 1) s = 1; for (i = s; i <= NR; i++) print line[i] }' "$_q_log")"
    _q_add_act "$(awk -f "$_q_HOME/lib/digest.awk" "$_q_log")"
  else
    _q_add_act "$(_q_msg ctx_empty)"
  fi

  # Fixed part B: index stats section.
  _q_idx=
  _q_add_idx() {
    _q_idx="${_q_idx}${1}
"
  }
  _q_add_idx "$(_q_msg ctx_index)"
  if [ -f "$_q_v/.quipu/index.tsv" ]; then
    _q_add_idx "$(wc -l < "$_q_v/.quipu/index.tsv" | tr -d ' ')"
  else
    _q_add_idx "0"
  fi

  # Variable part: Threads.md section (ctx_threads header + file content),
  # bounded to QUIPU_CTX_MAX bytes (C-16) at whole-line boundaries (C-17).
  _q_thr=
  if [ -f "$_q_v/Threads.md" ]; then
    _q_hdr=$(_q_msg ctx_threads)
    _q_marker=$(_q_msg ctx_truncated)
    _q_max=${QUIPU_CTX_MAX:-4096}
    _q_fixed=$(printf '%s%s' "$_q_act" "$_q_idx" | LC_ALL=C wc -c | tr -d ' ')
    _q_msize=$(printf '%s\n' "$_q_marker" | LC_ALL=C wc -c | tr -d ' ')
    _q_budget=$((_q_max - _q_fixed - _q_msize))
    _q_thr=$( {
      printf '%s\n' "$_q_marker"
      printf '%s\n' "$_q_hdr"
      cat "$_q_v/Threads.md"
    } | LC_ALL=C awk -v budget="$_q_budget" '
      NR == 1 { m = $0; next }
      cut { next }
      {
        n = length($0)
        if (acc + n + 1 > budget) { cut = 1; next }
        acc += n + 1
        print
      }
      END { if (cut) print m }
    ')
  fi

  if [ -n "$_q_thr" ]; then
    _q_text="$_q_act$_q_thr
$_q_idx"
  else
    _q_text="$_q_act$_q_idx"
  fi
}

_q_cmd_context() {
  _q_ev=
  _q_limit=10
  _q_bridge=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_ev=$2; shift 2 ;;
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      --bridge) _q_bridge=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  if [ "$_q_bridge" -eq 1 ] && [ -n "$_q_ev" ]; then
    _q_die err_conflict 2
  fi

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_ctx_text

  # Nudge (C-19/C-20): only --json UserPromptSubmit, once more than
  # QUIPU_NUDGE_AFTER lines accumulate past the watermarks.
  if [ -n "$_q_ev" ] && [ "$_q_ev" = UserPromptSubmit ] && [ -s "$_q_log" ]; then
    _q_nudge_after=${QUIPU_NUDGE_AFTER:-50}
    _q_total=$(wc -l < "$_q_log" | tr -d ' ')
    _q_last=0
    for _q_w in "$_q_v/.quipu/remembered" "$_q_v/.quipu/nudged"; do
      if [ -s "$_q_w" ]; then
        _q_pos=$(awk 'NR == 1 { wm = $0; next } $0 == wm { last = FNR } END { print (last + 0) }' "$_q_w" "$_q_log")
        if [ "$_q_pos" -gt "$_q_last" ]; then
          _q_last=$_q_pos
        fi
      fi
    done
    if [ $((_q_total - _q_last)) -gt "$_q_nudge_after" ]; then
      _q_lay=
      if [ -f "$_q_v/.quipu/config" ]; then
        _q_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
      fi
      case "$_q_lay" in
        emoji|plain) : ;;
        *) _q_lay=emoji ;;
      esac
      _q_tab=$(printf '\t')
      _q_sess=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_lay.txt" 2>/dev/null || true)
      # shellcheck disable=SC2059
      _q_nudge=$(printf "$(_q_msg ctx_precompact)" "$_q_sess")
      _q_text="${_q_text}${_q_nudge}
"
      _q_lastline=$(awk 'END { print $0 }' "$_q_log")
      printf '%s\n' "$_q_lastline" > "$_q_v/.quipu/nudged"
    fi
  fi

  if [ "$_q_bridge" -eq 1 ]; then
    # H-11/H-13: write the context into a dedicated AGENTS.md block, never the
    # static quipu:start block (init's property). printf (not echo) preserves
    # the exact text; block.awk guarantees idempotence + user-content safety.
    : >> "$_q_v/AGENTS.md"
    printf '%s' "$_q_text" | awk -v start='<!-- quipu:context:start -->' -v end='<!-- quipu:context:end -->' -f "$_q_HOME/lib/block.awk" "$_q_v/AGENTS.md" > "$_q_v/.quipu/agents.tmp" && mv "$_q_v/.quipu/agents.tmp" "$_q_v/AGENTS.md"
    _q_msg bridge_updated
    exit 0
  fi

  if [ -n "$_q_ev" ]; then
    # Context via stdin, not -v: awk -v processes escape sequences and
    # would corrupt Windows paths (C:\Users\...). JE_EV is a plain event
    # name, safe as -v.
    printf '%s' "$_q_text" | awk -v JE_EV="$_q_ev" -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_hookctx.awk"
  else
    printf '%s' "$_q_text"
  fi
}

# ---- remember ---------------------------------------------------------------

_q_cmd_remember() {
  _q_git=0
  _q_dry=0
  _q_limit=10

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --git) _q_git=1; shift ;;
      --dry-run) _q_dry=1; shift ;;
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_tab=$(printf '\t')
  _q_log="$_q_v/.quipu/activity.log"
  _q_wm="$_q_v/.quipu/remembered"

  # Slice: the lines AFTER the last occurrence of the watermark line (C-7).
  # The watermark is user data, so it flows via a file argument, never -v.
  if [ -s "$_q_wm" ]; then
    _q_slice=$(awk 'NR == 1 { wm = $0; next } { if ($0 == wm) last = NR; line[NR] = $0 } END { if (last) { for (i = last + 1; i <= NR; i++) print line[i] } else { for (i = 2; i <= NR; i++) print line[i] } }' "$_q_wm" "$_q_log")
  else
    _q_slice=$(cat "$_q_log" 2>/dev/null || true)
  fi

  if [ -z "$_q_slice" ]; then
    _q_msg remember_empty
    exit 0
  fi

  _q_digest=$(printf '%s\n' "$_q_slice" | awk -v mode=digest -f "$_q_HOME/lib/digest.awk")
  _q_last=$(printf '%s\n' "$_q_slice" | awk 'END{print}')

  _q_first=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $2; exit}')
  _q_lastts=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $3; exit}')
  _q_count=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $4; exit}')
  # Defensive (spec C-1): when the slice holds no valid events, nothing is
  # written and the watermark does not advance.
  if [ -z "$_q_count" ] || [ "$_q_count" = 0 ]; then
    _q_msg remember_empty
    exit 0
  fi

  _q_tools=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" 'BEGIN{OFS=sprintf("%c",9)} $1=="TOOL"{print $2, $3}' | sort -t "$_q_tab" -k2,2nr | awk -F"$_q_tab" '{ if (first) printf ", "; printf "%s %s", $1, $2; first=1 }')

  _q_layout=
  if [ -f "$_q_v/.quipu/config" ]; then
    _q_layout=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_layout" ]; then
    _q_layout=emoji
  fi
  _q_sessions=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt" 2>/dev/null || true)

  _q_day=$(date +%Y-%m-%d)
  _q_rel="$_q_sessions/$_q_day.md"
  _q_now=$(date +%H:%M)

  _q_body=$(mktemp "${TMPDIR:-/tmp}/quipu-remember-XXXXXX") || exit 1
  trap 'rm -f "$_q_body"' EXIT HUP INT TERM
  {
    printf '## %s\n' "$_q_now"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_range)\n" "$_q_first" "$_q_lastts" "$_q_count"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_tools)\n" "$_q_tools"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_files)\n" "$_q_limit"
    printf '%s\n' "$_q_digest" | awk -F"$_q_tab" 'BEGIN{OFS=sprintf("%c",9)} $1=="FILE"{print $2, $3}' | sort -t "$_q_tab" -k2,2nr | head -n "$_q_limit" | while IFS="$_q_tab" read -r _q_p _q_c; do
      printf '  - %2d  %s\n' "$_q_c" "$_q_p"
    done
  } > "$_q_body"

  if [ "$_q_dry" -eq 1 ]; then
    cat "$_q_body"
    exit 0
  fi

  mkdir -p "$_q_v/$_q_sessions"
  cat "$_q_body" >> "$_q_v/$_q_rel"

  _q_ls_body="$_q_day · $_q_count events · $_q_rel"
  : >> "$_q_v/Last-Session.md"
  printf '%s\n' "$_q_ls_body" | awk -f "$_q_HOME/lib/block.awk" "$_q_v/Last-Session.md" > "$_q_v/.quipu/lastsession.tmp" && mv "$_q_v/.quipu/lastsession.tmp" "$_q_v/Last-Session.md"

  printf '%s\n' "$_q_last" > "$_q_wm"

  if [ "$_q_git" -eq 1 ] && command -v git >/dev/null 2>&1; then
    if (cd "$_q_v" && git rev-parse --git-dir >/dev/null 2>&1); then
      if (cd "$_q_v" && git add -A && ! git diff --cached --quiet); then
        if (cd "$_q_v" && git commit -m "quipu: $_q_day" >/dev/null); then
          _q_msg remember_git
        fi
      fi
    fi
  fi

  # shellcheck disable=SC2059
  printf "$(_q_msg remember_ok)\n" "$_q_rel"
}

# ---- index ------------------------------------------------------------------

_q_cmd_index() {
  _q_full=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --full) _q_full=1 ;;
      *) usage; exit 2 ;;
    esac
    shift
  done

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_prof=
  if [ -f "$_q_v/.quipu/config" ]; then
    _q_prof=$(awk -F= -v k=fold '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_prof" ]; then
    if [ "$(_q_lang)" = tr ]; then
      _q_prof='tr'
    else
      _q_prof=default
    fi
  fi

  _q_tmp=$(mktemp -d "${TMPDIR:-/tmp}/quipu-index-XXXXXX") || exit 1
  trap 'rm -rf "$_q_tmp"' EXIT HUP INT TERM

  _q_old="$_q_tmp/old.tsv"
  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/.quipu/index.tsv" ]; then
    : > "$_q_old"
  else
    cp "$_q_v/.quipu/index.tsv" "$_q_old"
  fi

  (cd "$_q_v" && _q_mdlist) > "$_q_tmp/all.txt"

  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/.quipu/index.tsv" ]; then
    cp "$_q_tmp/all.txt" "$_q_tmp/changed.txt"
  else
    (cd "$_q_v" && _q_mdlist .quipu/index.tsv) > "$_q_tmp/changed.txt"
  fi

  (cd "$_q_v" && while IFS= read -r _q_p; do printf '%s\t%s\n' "$_q_p" "$(mtime "$_q_p")"; done < "$_q_tmp/changed.txt") > "$_q_tmp/cur.txt"

  awk -v mode=plan -v oldfile="$_q_tmp/old.tsv" -v allfile="$_q_tmp/all.txt" -f "$_q_HOME/lib/index.awk" "$_q_tmp/old.tsv" "$_q_tmp/cur.txt" "$_q_tmp/all.txt" > "$_q_tmp/plan.txt"

  N=0
  R=0
  S=0
  D=0
  _q_tab=$(printf '\t')
  : > "$_q_tmp/idx.tmp"
  while IFS="$_q_tab" read -r _q_verb _q_rest; do
    case "$_q_verb" in
      reuse|carry)
        printf '%s\n' "$_q_rest"
        R=$((R + 1))
        ;;
      stale)
        _q_p=${_q_rest%%"$_q_tab"*}
        _q_mt=${_q_rest#*"$_q_tab"}
        _q_meta=$(cd "$_q_v" && awk -v mode=meta -f "$_q_HOME/lib/index.awk" "$_q_p")
        # shellcheck disable=SC2018,SC2019
        _q_flat=$(cd "$_q_v" && sed -f "$_q_HOME/fold/$_q_prof.sed" "$_q_p" | tr 'A-Z' 'a-z' | awk -v mode=flat -v max=2000 -f "$_q_HOME/lib/index.awk")
        printf '%s\t%s\t%s\t%s\n' "$_q_p" "$_q_meta" "$_q_mt" "$_q_flat"
        S=$((S + 1))
        ;;
      drop)
        D=$((D + 1))
        ;;
    esac
  done < "$_q_tmp/plan.txt" > "$_q_tmp/idx.tmp"

  N=$((R + S))
  mv "$_q_tmp/idx.tmp" "$_q_v/.quipu/index.tsv"

  _q_fmt=$(_q_msg idx_summary)
  # shellcheck disable=SC2059
  printf "$_q_fmt" "$N" "$R" "$S" "$D"
  printf '\n'
}

# ---- search -----------------------------------------------------------------

_q_cmd_search() {
  _q_limit=10
  _q_paths=0
  _q_brief=0
  _q_query=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      --paths) _q_paths=1; shift ;;
      --brief) _q_brief=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        if [ -n "$_q_query" ]; then
          _q_query="$_q_query $1"
        else
          _q_query=$1
        fi
        shift
        ;;
    esac
  done

  if [ "$_q_brief" -eq 1 ] && [ "$_q_paths" -eq 1 ]; then
    _q_die err_conflict 2
  fi

  _q_v=$(_q_vault)

  # Fold profile: config fold= -> language tr -> tr -> default (same chain
  # and same fallback as `quipu index`).
  _q_prof=
  if [ -n "$_q_v" ] && [ -f "$_q_v/.quipu/config" ]; then
    _q_prof=$(awk -F= -v k=fold '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/.quipu/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_prof" ]; then
    if [ "$(_q_lang)" = tr ]; then
      _q_prof='tr'
    else
      _q_prof=default
    fi
  fi

  # Fold the query with the same profile and order as the index (PLAN 4.3):
  # sed -f fold/PROFIL.sed, THEN tr 'A-Z' 'a-z'. SC2018/SC2019 suggest
  # [:upper:]/[:lower:], but BSD tr is byte-based; after folding, plain ASCII
  # ranges are safe on every platform.
  # shellcheck disable=SC2018,SC2019
  _q_terms=$(printf '%s\n' "$_q_query" | sed -f "$_q_HOME/fold/$_q_prof.sed" | tr 'A-Z' 'a-z')
  [ -n "$_q_terms" ] || _q_die err_empty_query 2

  [ -n "$_q_v" ] || _q_die err_no_vault
  [ -f "$_q_v/.quipu/index.tsv" ] || _q_die err_no_index

  _q_tab=$(printf '\t')
  awk -v mode=bm25 -v terms="$_q_terms" -v brief="$_q_brief" -v snip=120 \
    -f "$_q_HOME/lib/search.awk" "$_q_v/.quipu/index.tsv" \
    | sort -k1,1nr -k4,4nr \
    | head -n "$_q_limit" \
    | awk -v p="$_q_paths" -F "$_q_tab" '{ if (p == 1) print $2; else print $0 }'
}

# ---- dispatch ---------------------------------------------------------------

_q_cmd=${1:-}
case "$_q_cmd" in
  --version) printf 'quipu 0.1.0\n'; exit 0 ;;
  doctor) _q_doctor ;;
  index) shift; _q_cmd_index "$@" ;;
  capture) shift; _q_cmd_capture "$@" ;;
  init) shift; _q_cmd_init "$@" ;;
  context) shift; _q_cmd_context "$@" ;;
  remember) shift; _q_cmd_remember "$@" ;;
  search) shift; _q_cmd_search "$@" ;;
  *) usage; exit 2 ;;
esac
